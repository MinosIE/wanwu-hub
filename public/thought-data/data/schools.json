  {
    "id": "taoism",
    "name": "道家",
    "nameEn": "Taoism",
    "span": "中国 · 先秦",
    "spanEn": "China · c. 400 BC",
    "level": 1,
    "order": 2,
    "core": "道法自然、无为而治，主张顺应事物的本然，以柔弱胜刚强、以不争达全。",
    "coreEn": "The Dao follows nature; govern by non-action (wuwei). Yield like water, and achieve through not striving.",
    "founders": ["老子", "庄子"],
    "foundersEn": ["Laozi", "Zhuangzi"],
    "keyIdeas": ["道：万物运行的根本", "无为：不妄为、因势利导", "柔弱胜刚强", "齐物：破除是非对待"],
    "keyIdeasEn": ["Dao: the underlying way of all things", "Wuwei: act without forcing", "Softness overcomes hardness", "Equality of opposites"],
    "strengths": ["对自然与自由的体悟极深", "为过度干预提供解毒剂"],
    "strengthsEn": ["Deep attunement to nature and freedom", "A corrective to over-intervention"],
    "criticisms": ["缺乏积极进取的行动方案", "容易滑向消极避世"],
    "criticismsEn": ["Offers little by way of active program", "Can slide into quietist withdrawal"],
    "related": ["confucianism", "buddhism", "laozi", "zhuangzi"],
    "sources": [{ "label": "《道德经》", "year": -400 }]
  },
  {
